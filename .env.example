# =============================================================================
# آدری‌استور — Environment variables
# Copy to .env.local for local dev. Set the same keys in Vercel Dashboard
# (Project → Settings → Environment Variables) for production.
# =============================================================================

# --- Basalam API (required for real products) ---
# Get token: https://developers.basalam.com/panel/tokens
# Scopes: vendor.product.read (or broader read access)
BASALAM_TOKEN=your_personal_access_token_here
BASALAM_VENDOR_ID=1213430

# --- Public site URL (required for SEO: sitemap, canonical, JSON-LD) ---
# After first Vercel deploy, set this to your production domain, e.g.:
# NEXT_PUBLIC_SITE_URL=https://adristore.vercel.app
NEXT_PUBLIC_SITE_URL=https://adristore.vercel.app

# --- Google Analytics 4 ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-CBFTXK2VEN

# --- Admin panel (/admin) ---
ADMIN_EMAIL=admin@adristore.com
ADMIN_PASSWORD=change_this_strong_password
# Used to sign session cookies — use a long random string in production
ADMIN_SECRET=change_this_to_a_long_random_secret

# =============================================================================
# Cloudflare Pages (static export)
# - Build command: npm run build
# - Output directory: out
# - Node.js: 20.x
# - Set BASALAM_TOKEN (and optionally BASALAM_VENDOR_ID) in Pages → Settings →
#   Environment variables. .env.local is optional for local builds only.
# =============================================================================

# =============================================================================
# Vercel notes
# - Build command: npm run build:server
# - Output: Next.js App Router (auto-detected)
# - Node.js: 20.x (default on Vercel)
# - Admin manual products / uploads write to local disk (data/, public/uploads/).
#   On Vercel these are EPHEMERAL — use Basalam as source of truth for products.
# =============================================================================